<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizAssetInfoMapper">

	<resultMap type="BizAssetInfo" id="BizAssetInfoResult">
		<id     property="assetId"       column="asset_id"       />
		<result property="assetCode"     column="asset_code"     />
		<result property="assetName"     column="asset_name"     />
		<result property="assetModel"    column="asset_model"    />
		<result property="category"      column="category"       />
		<result property="brand"         column="brand"          />
		<result property="price"         column="price"          />
		<result property="purchaseDate"  column="purchase_date"  />
		<result property="location"      column="location"       />
		<result property="ownerId"       column="owner_id"       />
		<result property="pic"           column="pic"            />
		<result property="status"        column="status"         />
		<result property="delFlag"       column="del_flag"       />
		<result property="createBy"      column="create_by"      />
		<result property="createTime"    column="create_time"    />
		<result property="updateBy"      column="update_by"      />
		<result property="updateTime"    column="update_time"    />
		<result property="remark"        column="remark"         />
		<result property="ownerName"     column="owner_name"     />
	</resultMap>

	<sql id="selectAssetVo">
		select a.asset_id, a.asset_code, a.asset_name, a.asset_model, a.category, a.brand, a.price, a.purchase_date,
		       a.location, a.owner_id, a.pic, a.status, a.del_flag, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
		       s.nick_name as owner_name
		from biz_asset_info a
			left join sys_user s on s.user_id = a.owner_id
	</sql>

	<select id="selectBizAssetInfoList" parameterType="BizAssetInfo" resultMap="BizAssetInfoResult">
		<include refid="selectAssetVo"/>
		<where>
			a.del_flag = '0'
			<if test="assetCode != null and assetCode != ''">
				AND a.asset_code like concat('%', #{assetCode}, '%')
			</if>
			<if test="assetName != null and assetName != ''">
				AND a.asset_name like concat('%', #{assetName}, '%')
			</if>
			<if test="category != null and category != ''">
				AND a.category = #{category}
			</if>
			<if test="status != null and status != ''">
				AND a.status = #{status}
			</if>
			<if test="ownerId != null">
				AND a.owner_id = #{ownerId}
			</if>
			<if test="params.beginPurchaseDate != null and params.beginPurchaseDate != ''"><!-- 采购日期开始 -->
				AND a.purchase_date &gt;= #{params.beginPurchaseDate}
			</if>
			<if test="params.endPurchaseDate != null and params.endPurchaseDate != ''"><!-- 采购日期结束 -->
				AND a.purchase_date &lt;= #{params.endPurchaseDate}
			</if>
		</where>
		order by a.create_time desc
	</select>

	<select id="selectBizAssetInfoByAssetId" parameterType="Long" resultMap="BizAssetInfoResult">
		<include refid="selectAssetVo"/>
		where a.asset_id = #{assetId} and a.del_flag = '0'
	</select>

	<select id="checkAssetCodeUnique" parameterType="String" resultMap="BizAssetInfoResult">
		<include refid="selectAssetVo"/>
		where a.asset_code = #{assetCode} and a.del_flag = '0' limit 1
	</select>

	<insert id="insertBizAssetInfo" parameterType="BizAssetInfo" useGeneratedKeys="true" keyProperty="assetId">
		insert into biz_asset_info(
			<if test="assetCode != null and assetCode != ''">asset_code,</if>
			<if test="assetName != null and assetName != ''">asset_name,</if>
			<if test="assetModel != null">asset_model,</if>
			<if test="category != null and category != ''">category,</if>
			<if test="brand != null">brand,</if>
			<if test="price != null">price,</if>
			<if test="purchaseDate != null">purchase_date,</if>
			<if test="location != null">location,</if>
			<if test="ownerId != null">owner_id,</if>
			<if test="pic != null">pic,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="remark != null">remark,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			create_time
		)values(
			<if test="assetCode != null and assetCode != ''">#{assetCode},</if>
			<if test="assetName != null and assetName != ''">#{assetName},</if>
			<if test="assetModel != null">#{assetModel},</if>
			<if test="category != null and category != ''">#{category},</if>
			<if test="brand != null">#{brand},</if>
			<if test="price != null">#{price},</if>
			<if test="purchaseDate != null">#{purchaseDate},</if>
			<if test="location != null">#{location},</if>
			<if test="ownerId != null">#{ownerId},</if>
			<if test="pic != null">#{pic},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="remark != null">#{remark},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			sysdate()
		)
	</insert>

	<update id="updateBizAssetInfo" parameterType="BizAssetInfo">
		update biz_asset_info
		<set>
			<if test="assetCode != null and assetCode != ''">asset_code = #{assetCode},</if>
			<if test="assetName != null and assetName != ''">asset_name = #{assetName},</if>
			<if test="assetModel != null">asset_model = #{assetModel},</if>
			<if test="category != null and category != ''">category = #{category},</if>
			<if test="brand != null">brand = #{brand},</if>
			<if test="price != null">price = #{price},</if>
			<if test="purchaseDate != null">purchase_date = #{purchaseDate},</if>
			<if test="location != null">location = #{location},</if>
			<if test="ownerId != null">owner_id = #{ownerId},</if>
			<if test="pic != null">pic = #{pic},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="remark != null">remark = #{remark},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			update_time = sysdate()
		</set>
		where asset_id = #{assetId}
	</update>

	<!-- 逻辑删除 -->
	<delete id="deleteBizAssetInfoByAssetId" parameterType="Long">
		update biz_asset_info set del_flag = '1' where asset_id = #{assetId}
	</delete>

	<delete id="deleteBizAssetInfoByAssetIds" parameterType="Long">
		update biz_asset_info set del_flag = '1' where asset_id in
		<foreach collection="array" item="assetId" open="(" separator="," close=")">
			#{assetId}
		</foreach>
	</delete>

	<!-- 同步资产状态（领用/归还/维修联动用） -->
	<update id="updateAssetStatus">
		update biz_asset_info set status = #{status}, update_time = sysdate() where asset_id = #{assetId} and del_flag = '0'
	</update>

	<!-- 统计编码前缀占用数量：含已删除数据，防止自动编码与历史编码冲突 -->
	<select id="countAssetCodeByPrefix" parameterType="String" resultType="int">
		select count(*) from biz_asset_info where asset_code like concat(#{assetCodePrefix}, '%')
	</select>

</mapper>
